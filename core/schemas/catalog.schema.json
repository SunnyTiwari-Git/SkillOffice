{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SunnyTiwari-Git/SkillOffice/core/schemas/catalog.schema.json",
  "title": "Department catalog.yaml",
  "type": "object",
  "required": [
    "department",
    "skills"
  ],
  "properties": {
    "department": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "depends_on",
          "risk",
          "cacheable"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "maxLength": 160
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "cacheable": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
