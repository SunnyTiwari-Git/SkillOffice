{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SunnyTiwari-Git/SkillOffice/core/schemas/skill.schema.json",
  "title": "SkillOffice skill.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "kind",
    "department",
    "summary",
    "inputs",
    "outputs",
    "depends_on",
    "context_needs",
    "risk",
    "side_effects",
    "cacheable",
    "platforms_tested",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "enum": [
        "skill",
        "manager",
        "core"
      ]
    },
    "department": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_needs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+(\\.[a-z0-9_]+)+$"
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "side_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "none",
          "reads_files",
          "writes_files",
          "runs_scripts",
          "network",
          "external_actions"
        ]
      }
    },
    "cacheable": {
      "type": "boolean"
    },
    "platforms_tested": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "platform",
          "date",
          "result"
        ],
        "properties": {
          "platform": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "partial"
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "original",
            "adapted"
          ]
        },
        "source_id": {
          "type": "string"
        },
        "upstream_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "adapted"
          }
        }
      },
      "then": {
        "required": [
          "source_id",
          "upstream_commit"
        ]
      }
    }
  }
}
